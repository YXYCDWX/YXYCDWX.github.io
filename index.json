[{"content":"","date":"2026年10月23日","externalUrl":null,"permalink":"/categories/","section":"Categories","summary":"","title":"Categories","type":"categories"},{"content":"","date":"2026年10月23日","externalUrl":null,"permalink":"/tags/k230/","section":"Tags","summary":"","title":"K230","type":"tags"},{"content":"","date":"2026年10月23日","externalUrl":null,"permalink":"/tags/nncase/","section":"Tags","summary":"","title":"Nncase","type":"tags"},{"content":"","date":"2026年10月23日","externalUrl":null,"permalink":"/tags/","section":"Tags","summary":"","title":"Tags","type":"tags"},{"content":"","date":"2026年10月23日","externalUrl":null,"permalink":"/tags/yolov8/","section":"Tags","summary":"","title":"YOLOv8","type":"tags"},{"content":"本文为示例文档，展示文章的编写格式。替换为你的真实内容即可。\n1. 数据集准备 # 使用 Ultralytics 标准目录结构，注意以下约束：\n单进程 DataLoader，避免 Windows 平台死锁 数据增强只做亮度/光照/饱和度类光学变换，避免破坏颜色特征 2. 训练 # yolo detect train model=yolov8n.pt data=dataset.yaml epochs=200 imgsz=640 训练完成后检查中间保存的权重，对比最新一轮的 mAP。\n3. 剪枝与导出 # yolo export model=best.pt format=onnx opset=12 4. nncase 量化转换 # 使用 nncase 2.9.0 进行 16 位定点量化，适配 K230 KPU。\n相关阅读 # 教学视频：同主题视频教程 ","date":"2026年10月23日","externalUrl":null,"permalink":"/docs/yolov8-to-k230-deploy/","section":"技术文档","summary":"","title":"YOLOv8 训练到 K230 部署全流程","type":"docs"},{"content":"示例视频页：将下方 shortcode 中的 BV 号替换为你自己的视频。\n视频 # 配套文档 # YOLOv8 训练到 K230 部署全流程 ","date":"2026年10月23日","externalUrl":null,"permalink":"/videos/yolov8-training-course/","section":"教学视频","summary":"","title":"YOLOv8 训练与部署实战（视频）","type":"videos"},{"content":"","date":"2026年10月23日","externalUrl":null,"permalink":"/categories/%E7%AB%AF%E4%BE%A7%E9%83%A8%E7%BD%B2/","section":"Categories","summary":"","title":"端侧部署","type":"categories"},{"content":"","date":"2026年10月23日","externalUrl":null,"permalink":"/docs/","section":"技术文档","summary":"","title":"技术文档","type":"docs"},{"content":"","date":"2026年10月23日","externalUrl":null,"permalink":"/tags/%E6%95%99%E5%AD%A6/","section":"Tags","summary":"","title":"教学","type":"tags"},{"content":"","date":"2026年10月23日","externalUrl":null,"permalink":"/videos/","section":"教学视频","summary":"","title":"教学视频","type":"videos"},{"content":"","date":"2026年10月23日","externalUrl":null,"permalink":"/tags/%E6%A8%A1%E5%9E%8B%E9%83%A8%E7%BD%B2/","section":"Tags","summary":"","title":"模型部署","type":"tags"},{"content":"","date":"2026年10月23日","externalUrl":null,"permalink":"/categories/%E8%A7%86%E9%A2%91%E6%95%99%E7%A8%8B/","section":"Categories","summary":"","title":"视频教程","type":"categories"},{"content":"欢迎来到我的个人站。这里分为三个核心板块，按需取阅：\n技术文档：深度学习、模型部署、具身智能相关的系统性笔记与踩坑记录 教学视频：配套 B 站视频教程，图文与视频对照学习 成果展示：项目作品、算法成果与工程实现 ","date":"2026年10月23日","externalUrl":null,"permalink":"/","section":"首页","summary":"","title":"首页","type":"page"},{"content":"","date":"2026年10月20日","externalUrl":null,"permalink":"/tags/opencv/","section":"Tags","summary":"","title":"OpenCV","type":"tags"},{"content":"","date":"2026年10月20日","externalUrl":null,"permalink":"/tags/%E5%B7%A5%E7%A8%8B%E5%AE%9E%E8%B7%B5/","section":"Tags","summary":"","title":"工程实践","type":"tags"},{"content":"","date":"2026年10月20日","externalUrl":null,"permalink":"/tags/%E7%9B%AE%E6%A0%87%E6%A3%80%E6%B5%8B/","section":"Tags","summary":"","title":"目标检测","type":"tags"},{"content":"本文为示例文档，替换为你的真实内容即可。\n置信度阈值 # 检测目标较小时将 Conf 下调至 0.25 或更低，配合窗口大小（Win）与物体实际尺寸匹配。\nOpenCV 颜色后处理 # 通过邻域集中度阈值过滤噪点，确定检测物体的主色，用于辅助校验 YOLO 输出。\n跟踪参数 # 可通过终端实时调整：Conf、Win、IoU、Age、MOE。\n","date":"2026年10月20日","externalUrl":null,"permalink":"/docs/detection-engineering-notes/","section":"技术文档","summary":"","title":"目标检测工程实践：低置信度阈值与颜色后处理","type":"docs"},{"content":"","date":"2026年10月20日","externalUrl":null,"permalink":"/categories/%E7%AE%97%E6%B3%95%E5%B7%A5%E7%A8%8B/","section":"Categories","summary":"","title":"算法工程","type":"categories"},{"content":"","externalUrl":null,"permalink":"/authors/","section":"Authors","summary":"","title":"Authors","type":"authors"},{"content":"示例成果页，替换为你的真实项目。\n概述 # 在 K230 端侧设备上实现实时的颜色目标检测与跟踪：\nYOLOv8n 剪枝 + 16 位定点量化，kmodel 部署于 KPU OpenCV 颜色后处理辅助校验检测结果 面板可实时调参：Conf、Win、IoU、Age、MOE 技术要点 # 模块 方案 检测 YOLOv8n（剪枝） 量化 nncase 2.9.0，16 位定点 后处理 C/C++ K230 后处理 + OpenCV 颜色过滤 ","externalUrl":null,"permalink":"/projects/k230-color-detection/","section":"成果展示","summary":"","title":"K230 颜色目标检测系统","type":"projects"},{"content":"","externalUrl":null,"permalink":"/series/","section":"Series","summary":"","title":"Series","type":"series"},{"content":"","externalUrl":null,"permalink":"/projects/","section":"成果展示","summary":"","title":"成果展示","type":"projects"},{"content":"","externalUrl":null,"permalink":"/tags/%E7%AB%AF%E4%BE%A7%E9%83%A8%E7%BD%B2/","section":"Tags","summary":"","title":"端侧部署","type":"tags"},{"content":" 简介 # 深度学习 × 具身智能方向工程师。主要工作方向：\n目标检测与视觉算法：熟悉 Ultralytics YOLO 系列的训练、剪枝与量化部署 端侧模型部署：K230 KPU、ONNX、nncase 工具链 具身智能：感知模块与机器人系统的工程化落地 技术栈 # 领域 工具 训练框架 PyTorch、Ultralytics YOLOv8 视觉处理 OpenCV、ONNX 端侧部署 nncase、kmodel、K230 语言 Python、C/C++ 联系方式 # GitHub：YXYCDWX B 站：教学视频发布渠道，见「教学视频」板块 ","externalUrl":null,"permalink":"/about/","section":"首页","summary":"","title":"关于我","type":"page"},{"content":"","externalUrl":null,"permalink":"/categories/%E9%A1%B9%E7%9B%AE/","section":"Categories","summary":"","title":"项目","type":"categories"}]